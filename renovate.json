{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>PauseAI/.github:renovate"
  ],
  "packageRules": [
    {
      "description": "Node comes from .nvmrc (Railway's build); bump it on purpose, not by bot",
      "matchManagers": [
        "nvm"
      ],
      "enabled": false
    },
    {
      "description": "...and the matching engines.node in package.json",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchPackageNames": [
        "node"
      ],
      "enabled": false
    }
  ]
}
